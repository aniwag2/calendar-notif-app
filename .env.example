# ==============================================================================
# Theralert (Go) environment variables
# Copy to .env and fill in values. Do NOT commit your .env file.
# ==============================================================================

# --- Server ---
ADDR=:3002
# Display timezone for the clock, calendar, and email times (IANA name).
# Examples: America/New_York, America/Chicago, Europe/London. Defaults to UTC.
TZ=America/New_York
# Public base URL of the app.
BASE_URL=https://theralert.aniwaghray.com
# Where the "Log out" button sends users.
LOGOUT_URL=https://theralert.aniwaghray.com
# Set true when served over HTTPS so session cookies get the Secure flag.
SECURE_COOKIES=true
# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change_me_to_a_long_random_string

# --- Database (PostgreSQL) ---
# Used by docker-compose to provision the db container.
DB_NAME=theralert
DB_USER=theralert
DB_PASSWORD=change_me_strong_password
# The app reads DATABASE_URL directly. In docker-compose this is built from the
# DB_* vars above; for a standalone run set it explicitly, e.g.:
# DATABASE_URL=postgres://theralert:change_me_strong_password@localhost:5432/theralert?sslmode=disable

# --- Registration network restriction ---
# Comma-separated CIDRs/IPs allowed to register. Empty = allow all.
# Example: ALLOWED_CIDRS=203.0.113.0/24,198.51.100.42
ALLOWED_CIDRS=

# --- Email (SMTP) — used in Phase 3 notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=theralert@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=theralert@gmail.com
